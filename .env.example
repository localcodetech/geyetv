# Optional: read live channels from the Supabase `content` table.
# Without these, channels come from src/data/channels.json.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Movies: The Movie Database (https://www.themoviedb.org/settings/api).
# Use the "API Read Access Token" (preferred) or the v3 "API Key".
TMDB_READ_TOKEN=
# TMDB_API_KEY=
# Country for "Where to watch" and age ratings (default GH)
TMDB_REGION=GH
